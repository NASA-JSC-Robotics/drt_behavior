            goal_pose="{pose}"
            pipeline="pilz_industrial_motion_planner"
            planner="LIN"
            orientation_tolerance="{orientation_tolerance=0.0872665;0.10872665;0.0872665}"
            velocity_scaling="{velocity_scaling=1.0}"
