<root BTCPP_format="4">

    <BehaviorTree ID="rrt_to_transform">
      <Sequence>
        <TransformToPose
            name="transform_to_pose"
            transform_stamped="{transform}"
            pose_stamped="{pose}"/>
        <PlanToPose
            name="Plan to transform"
            service_name="/plan_kinematic_path"
            group_name="{group_name}"
            end_effector_name="{end_effector_name}"
            goal_pose="{pose}"
            pipeline="ompl"
            planner="{planner=RRTConnect}"
            orientation_tolerance="{orientation_tolerance=0.05;0.05;0.05}"
            velocity_scaling="{velocity_scaling=1.0}"
            acceleration_scaling="{acceleration_scaling=1.0}"
            trajectory="{traj_to_pose}"/>
        <ExecuteTrajectory
            name="Execute the trajectory "
            trajectory="{traj_to_pose}"
            action_name="/execute_trajectory"/>
      </Sequence>
    </BehaviorTree>


