<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>geometry_behavior</name>
    <version>1.0.0</version>
    <description>BT.CPP behaviors for interacting with tf and geometry types</description>
    <maintainer email="misha.savchenko@nasa.gov">Misha Savchenko</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake_ros</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>geometry_msgs</depend>
    <depend>tf2_eigen</depend>

    <depend>drt_behavior</depend>
    <depend>behaviortree_cpp</depend>
    <depend>behaviortree_ros2</depend>
    <depend>btcpp_ros2_interfaces</depend>

    <test_depend>ament_cmake_gtest</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
